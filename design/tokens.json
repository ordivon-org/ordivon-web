{
  "color": {
    "$type": "color",
    "ink": {
      "$description": "Primary dark canvas.",
      "$value": { "colorSpace": "srgb", "components": [0.043137, 0.054902, 0.078431], "alpha": 1, "hex": "#0b0e14" },
      "$extensions": { "org.ordivon.css": { "variable": "--ink" } }
    },
    "ink-soft": {
      "$description": "Raised dark canvas for hover and secondary regions.",
      "$value": { "colorSpace": "srgb", "components": [0.066667, 0.086275, 0.12549], "alpha": 1, "hex": "#111620" },
      "$extensions": { "org.ordivon.css": { "variable": "--ink-soft" } }
    },
    "surface": {
      "$description": "Primary elevated surface.",
      "$value": { "colorSpace": "srgb", "components": [0.090196, 0.113725, 0.160784], "alpha": 1, "hex": "#171d29" },
      "$extensions": { "org.ordivon.css": { "variable": "--surface" } }
    },
    "surface-strong": {
      "$description": "Higher-emphasis elevated surface.",
      "$value": { "colorSpace": "srgb", "components": [0.117647, 0.152941, 0.207843], "alpha": 1, "hex": "#1e2735" },
      "$extensions": { "org.ordivon.css": { "variable": "--surface-strong" } }
    },
    "paper": {
      "$description": "Primary foreground text and marks.",
      "$value": { "colorSpace": "srgb", "components": [0.886275, 0.905882, 0.937255], "alpha": 1, "hex": "#e2e7ef" },
      "$extensions": { "org.ordivon.css": { "variable": "--paper" } }
    },
    "paper-soft": {
      "$description": "Secondary high-contrast foreground.",
      "$value": { "colorSpace": "srgb", "components": [0.741176, 0.776471, 0.827451], "alpha": 1, "hex": "#bdc6d3" },
      "$extensions": { "org.ordivon.css": { "variable": "--paper-soft" } }
    },
    "muted": {
      "$description": "De-emphasized text and annotation.",
      "$value": { "colorSpace": "srgb", "components": [0.498039, 0.541176, 0.603922], "alpha": 1, "hex": "#7f8a9a" },
      "$extensions": { "org.ordivon.css": { "variable": "--muted" } }
    },
    "line": {
      "$description": "Low-emphasis divider derived from the paper family.",
      "$value": { "colorSpace": "srgb", "components": [0.886275, 0.905882, 0.937255], "alpha": 0.13, "hex": "#e2e7ef" },
      "$extensions": { "org.ordivon.css": { "variable": "--line" } }
    },
    "line-strong": {
      "$description": "High-emphasis divider derived from the paper family.",
      "$value": { "colorSpace": "srgb", "components": [0.886275, 0.905882, 0.937255], "alpha": 0.24, "hex": "#e2e7ef" },
      "$extensions": { "org.ordivon.css": { "variable": "--line-strong" } }
    },
    "accent": {
      "$description": "Primary Ordivon interaction and emphasis accent.",
      "$value": { "colorSpace": "srgb", "components": [0.568627, 0.529412, 1], "alpha": 1, "hex": "#9187ff" },
      "$extensions": { "org.ordivon.css": { "variable": "--accent" } }
    },
    "accent-soft": {
      "$description": "Higher-luminance accent for text and fine marks.",
      "$value": { "colorSpace": "srgb", "components": [0.698039, 0.670588, 1], "alpha": 1, "hex": "#b2abff" },
      "$extensions": { "org.ordivon.css": { "variable": "--accent-soft" } }
    },
    "success": {
      "$description": "Positive or accepted state signal.",
      "$value": { "colorSpace": "srgb", "components": [0.439216, 0.796078, 0.635294], "alpha": 1, "hex": "#70cba2" },
      "$extensions": { "org.ordivon.css": { "variable": "--success" } }
    },
    "signal": {
      "$description": "Attention, experimental, or caution signal.",
      "$value": { "colorSpace": "srgb", "components": [0.878431, 0.627451, 0.435294], "alpha": 1, "hex": "#e0a06f" },
      "$extensions": { "org.ordivon.css": { "variable": "--signal" } }
    }
  },
  "layout": {
    "$type": "dimension",
    "max-width": {
      "$description": "Maximum public page shell width.",
      "$value": { "value": 1280, "unit": "px" },
      "$extensions": { "org.ordivon.css": { "variable": "--max" } }
    },
    "article-width": {
      "$description": "Long-form reading column width.",
      "$value": { "value": 43, "unit": "rem" },
      "$extensions": { "org.ordivon.css": { "variable": "--article" } }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$description": "Interface and display typography stack.",
      "$value": ["Helvetica Neue", "Inter", "Arial", "sans-serif"],
      "$extensions": { "org.ordivon.css": { "variable": "--sans" } }
    },
    "serif": {
      "$description": "Long-form editorial reading stack.",
      "$value": ["Iowan Old Style", "Palatino Linotype", "Palatino", "Georgia", "serif"],
      "$extensions": { "org.ordivon.css": { "variable": "--serif" } }
    },
    "mono": {
      "$description": "Evidence, metadata, and technical annotation stack.",
      "$value": ["SFMono-Regular", "Consolas", "Liberation Mono", "monospace"],
      "$extensions": { "org.ordivon.css": { "variable": "--mono" } }
    }
  }
}
