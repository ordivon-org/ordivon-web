{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ordivon-web-v2-preview",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": true
}
