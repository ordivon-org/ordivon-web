{
  "name": "ordivon-web",
  "version": "2.0.0-alpha.1",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "social:generate": "python3 scripts/generate-social-cards.py",
    "start": "python3 -m http.server 8788 --directory out",
    "preview": "pnpm build && pnpm start",
    "deploy": "pnpm build && node scripts/deploy-pages.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern app components content lib scripts tests eslint.config.mjs mdx-components.tsx next.config.ts playwright.config.ts",
    "test": "pnpm build && playwright test tests/smoke.spec.ts",
    "test:smoke": "pnpm build && playwright test tests/smoke.spec.ts",
    "check": "pnpm publication:check && pnpm typecheck && pnpm lint && pnpm build && playwright test tests/smoke.spec.ts",
    "publication:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/validate-publications.mjs",
    "site:audit": "node scripts/site-audit.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.2.12",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.0",
    "@types/mdx": "2.0.14",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "typescript": "6.0.2"
  }
}
