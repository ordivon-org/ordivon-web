{
  "name": "ordivon-web",
  "version": "2.0.0-alpha.1",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:worker": "opennextjs-cloudflare build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:workerd": "node scripts/verify-workerd.mjs",
    "capture:v1": "node scripts/capture-v1-baseline.mjs",
    "check": "pnpm migrate:v1 && pnpm typecheck && pnpm lint && pnpm audit:prod && pnpm build && pnpm test:smoke && pnpm test:a11y && pnpm build:worker && pnpm test:workerd",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "migrate:v1": "node scripts/migrate-v1-writing.mjs",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "capture:v2": "node scripts/capture-v2-round2.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.2.12",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "1.62.0",
    "@types/mdx": "2.0.14",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "cheerio": "1.1.2",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "typescript": "6.0.2",
    "wrangler": "4.115.0"
  }
}
