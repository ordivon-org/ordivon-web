{
  "name": "ordivon-web",
  "version": "2.0.0-alpha.1",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:static": "next build --webpack",
    "start": "wrangler pages dev out --port 8788",
    "preview": "pnpm build && wrangler pages dev out --port 8788",
    "preview:static": "wrangler pages dev out --port 8788",
    "deploy": "pnpm build && wrangler pages deploy out --project-name ordivon-web-v2-preview --branch rebuild/web-v2",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib scripts tests eslint.config.mjs mdx-components.tsx next.config.ts playwright.config.ts playwright.release.config.ts",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:cross-browser": "playwright test --config playwright.release.config.ts",
    "test:cross-browser:host": "playwright test --config playwright.release.config.ts --project=chromium-release --project=firefox-release --project=mobile-chromium-release",
    "test:webkit:container": "node scripts/test-webkit-container.mjs",
    "verify:static": "node scripts/verify-static-platform.mjs",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "audit:links": "node scripts/audit-external-links.mjs",
    "check": "pnpm migrate:v1 && pnpm typecheck && pnpm lint && pnpm audit:prod && pnpm build && pnpm test:smoke && pnpm test:a11y && pnpm verify:static",
    "check:release": "pnpm check && pnpm test:cross-browser && pnpm audit:lighthouse && pnpm audit:links",
    "check:release:local": "pnpm check && pnpm test:cross-browser:host && pnpm test:webkit:container && pnpm audit:lighthouse && pnpm audit:links",
    "migrate:v1": "node scripts/migrate-v1-writing.mjs",
    "capture:v1": "node scripts/capture-v1-baseline.mjs",
    "capture:v2": "node scripts/capture-v2-round2.mjs",
    "measure:v2": "node scripts/measure-v2-layout.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.2.12",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.0",
    "@types/mdx": "2.0.14",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "cheerio": "1.1.2",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "lighthouse": "13.4.1",
    "typescript": "6.0.2",
    "wrangler": "4.115.0"
  }
}
