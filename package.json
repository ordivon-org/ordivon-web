{
  "name": "ordivon-web",
  "version": "2.0.0-alpha.1",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile",
    "dev": "pnpm content:generate && next dev --webpack",
    "build": "pnpm content:generate && next build --webpack",
    "social:generate": "python3 scripts/generate-social-cards.py",
    "social:verify-render": "python3 scripts/generate-social-cards.py --verify-render",
    "social:review": "python3 scripts/generate-social-cards.py --review-dir out/social-review",
    "start": "python3 -m http.server 8788 --directory out",
    "preview": "pnpm build && pnpm start",
    "typecheck": "pnpm content:generate && next typegen && tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern app components content lib scripts tests eslint.config.mjs mdx-components.tsx next.config.ts playwright.config.ts",
    "test": "pnpm build && node scripts/run-playwright.mjs test tests/smoke.spec.ts",
    "test:smoke": "pnpm build && node scripts/run-playwright.mjs test tests/smoke.spec.ts",
    "check": "pnpm content:generate && pnpm design:check && pnpm publication:check && next typegen && tsc --noEmit && pnpm lint && next build --webpack && pnpm budget:report && node scripts/run-playwright.mjs test tests/smoke.spec.ts",
    "publication:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/validate-publications.mjs && python3 scripts/generate-social-cards.py --check",
    "design:generate": "node scripts/generate-design-tokens.mjs",
    "design:check": "pnpm design:generate && node scripts/generate-design-tokens.mjs --check && node scripts/validate-design-context.mjs",
    "agent:context": "node scripts/report-agent-web-context.mjs",
    "agent:context:currentness": "node scripts/report-agent-web-currentness.mjs",
    "promotion:preflight": "node scripts/run-web-promotion-preflight.mjs",
    "promotion:admit": "node scripts/admit-web-promotion.mjs",
    "browser:review": "pnpm build && node scripts/review-browser-surfaces.mjs",
    "browser:review:current": "node scripts/review-browser-surfaces.mjs",
    "research:r6:encounter": "node scripts/run-r6-encounter.mjs",
    "research:m7:interaction": "node scripts/run-m7-interaction.mjs",
    "site:audit": "node scripts/site-audit.mjs",
    "content:generate": "node scripts/generate-design-tokens.mjs && node scripts/generate-project-projections.mjs && node scripts/generate-article-manifest.mjs",
    "pages:prepare": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/prepare-pages.mjs",
    "budget:report": "node scripts/report-static-budget.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.2.12",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.0",
    "@types/mdx": "2.0.14",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "typescript": "6.0.2"
  }
}
